# Copia este ficheiro para .env e preenche com valores reais.
# Nunca commitar o .env (já está no .gitignore).

# Ligação à base de dados PostgreSQL.
# No Railway: usa a variável ${{Postgres.DATABASE_URL}} fornecida pelo plugin.
DATABASE_URL="postgresql://user:password@localhost:5432/var_dev"

# Segredo usado para assinar os tokens JWT — tem de ser um valor longo e
# aleatório em produção (ex: `openssl rand -base64 48`). Nunca reutilizar
# o valor de desenvolvimento.
JWT_SECRET="troca-me-por-um-valor-aleatorio-forte"

# Validade do token de sessão.
JWT_EXPIRES_IN="7d"

# Porta do servidor — o Railway define isto automaticamente, não precisas
# de configurar em produção.
PORT=3333

NODE_ENV="development"

# Domínios adicionais (além de localhost:3000) autorizados a chamar a API,
# separados por vírgula. Ex: "https://var.kituxitech.com"
CORS_ORIGINS=""
